pipeline {
    agent any
    options {
        skipDefaultCheckout()
        disableConcurrentBuilds()
        timestamps()
        timeout(time: 60, unit: 'MINUTES')
    }
    environment {
        GIT_REPO           = "https://github.com/Anandreddy125/project-management.git"
        GIT_CREDENTIALS_ID = "github-anand"
        DOCKER_CREDENTIALS_ID = "docker-test"
        IMAGE_NAME            = "anrs125/testing-repo"
    }
    /*
      IMPORTANT:
      - Job is triggered by Generic Webhook Trigger
      - Webhook provides variable: ref = refs/tags/v1.0.0
    */
    stages {
        /* ================= PRE-CHECK ================= */
        stage('Validate Webhook Event') {
            steps {
                script {
                    if (!env.ref) {
                        echo ":x: No ref received from webhook"
                        currentBuild.result = 'NOT_BUILT'
                        return
                    }
                    if (!env.ref.startsWith("refs/tags/")) {
                        echo ":information_source: Not a tag push (${env.ref}). Skipping build."
                        currentBuild.result = 'NOT_BUILT'
                        return
                    }
                    env.IMAGE_TAG = env.ref.replace("refs/tags/", "")
                    echo ":white_check_mark: Tag detected from webhook: ${env.IMAGE_TAG}"
                }
            }
        }
        /* ================= CLEAN ================= */
        stage('Clean Workspace') {
            when { expression { env.IMAGE_TAG } }
            steps {
                cleanWs()
            }
        }
        /* ================= CHECKOUT ================= */
        stage('Checkout Tag') {
            when { expression { env.IMAGE_TAG } }
            steps {
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: "refs/tags/${env.IMAGE_TAG}"]],
                    userRemoteConfigs: [[
                        url: env.GIT_REPO,
                        credentialsId: env.GIT_CREDENTIALS_ID
                    ]]
                ])
                sh 'git fetch origin master --tags --force'
            }
        }
        /* ================= VERIFY MASTER ================= */
        stage('Verify Tag Is From Master') {
            when { expression { env.IMAGE_TAG } }
            steps {
                script {
                    def onMaster = sh(
                        script: "git branch -r --contains HEAD | grep origin/master || true",
                        returnStdout: true
                    ).trim()
                    if (!onMaster) {
                        error(":x: Tag ${env.IMAGE_TAG} is NOT created from master branch")
                    }
                    echo ":white_check_mark: Tag ${env.IMAGE_TAG} verified on master branch"
                }
            }
        }
        /* ================= BUILD & PUSH ================= */
        stage('Docker Build & Push') {
            when { expression { env.IMAGE_TAG } }
            steps {
                withCredentials([usernamePassword(
                    credentialsId: env.DOCKER_CREDENTIALS_ID,
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASSWORD'
                )]) {
                    sh """
                        echo "\$DOCKER_PASSWORD" | docker login -u "\$DOCKER_USER" --password-stdin
                        docker build -t ${IMAGE_NAME}:${IMAGE_TAG} .
                        docker push ${IMAGE_NAME}:${IMAGE_TAG}
                    """
                }
            }
        }
    }
    post {
        success {
            echo ":rocket: Production image pushed successfully"
            echo "IMAGE: ${IMAGE_NAME}:${IMAGE_TAG}"
        }
        always {
            cleanWs()
        }
    }
}




