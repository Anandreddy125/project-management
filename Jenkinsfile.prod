pipeline {
    agent any
    options {
        skipDefaultCheckout()
        disableConcurrentBuilds()
        timestamps()
        timeout(time: 60, unit: 'MINUTES')
    }
    environment {
        GIT_REPO           = "https://github.com/Anandreddy125/project-management.git"
        GIT_CREDENTIALS_ID = "github-anand"
        DOCKER_CREDENTIALS_ID = "docker-test"
        IMAGE_NAME            = "anrs125/testing-repo"
    }
    /*
     :x: DO NOT use githubPush()
     :white_check_mark: Job is triggered via Generic Webhook Trigger (configured in UI)
    */
    stages {
        /* ================= CLEAN ================= */
        stage('Clean Workspace') {
            steps {
                cleanWs()
            }
        }
        /* ================= CHECKOUT MASTER ================= */
        stage('Checkout Master') {
            steps {
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: 'refs/heads/master']],
                    userRemoteConfigs: [[
                        url: env.GIT_REPO,
                        credentialsId: env.GIT_CREDENTIALS_ID
                    ]]
                ])
                // Ensure all tags are available
                sh 'git fetch --tags --force'
            }
        }
        /* ================= VALIDATE TAG ================= */
        stage('Validate Production Tag') {
            steps {
                script {
                    // Detect tag pointing to master HEAD
                    def tag = sh(
                        script: "git tag --points-at HEAD | head -n 1",
                        returnStdout: true
                    ).trim()
                    if (!tag) {
                        echo ":information_source: No tag found on master HEAD. Skipping production build."
                        currentBuild.result = 'NOT_BUILT'
                        return
                    }
                    // Safety check: tag must belong to master
                    def onMaster = sh(
                        script: "git branch -r --contains ${tag} | grep origin/master || true",
                        returnStdout: true
                    ).trim()
                    if (!onMaster) {
                        error(":x: Tag ${tag} is NOT created from master branch")
                    }
                    env.IMAGE_TAG = tag
                    echo ":white_check_mark: Production tag verified: ${env.IMAGE_TAG}"
                }
            }
        }
        /* ================= BUILD & PUSH ================= */
        stage('Docker Build & Push') {
            when {
                expression { env.IMAGE_TAG?.trim() }
            }
            steps {
                withCredentials([usernamePassword(
                    credentialsId: env.DOCKER_CREDENTIALS_ID,
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASSWORD'
                )]) {
                    sh """
                        echo "\$DOCKER_PASSWORD" | docker login -u "\$DOCKER_USER" --password-stdin
                        docker build -t ${IMAGE_NAME}:${IMAGE_TAG} .
                        docker push ${IMAGE_NAME}:${IMAGE_TAG}
                    """
                }
            }
        }
    }
    post {
        success {
            echo ":white_check_mark: Production build successful"
            echo ":rocket: Docker Image pushed: ${IMAGE_NAME}:${IMAGE_TAG}"
        }
        always {
            cleanWs()
        }
    }
}