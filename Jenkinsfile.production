pipeline {
    agent any

    options {
        disableConcurrentBuilds()
        timestamps()
        timeout(time: 60, unit: 'MINUTES')
    }

    environment {
        GIT_REPO              = "https://github.com/Anandreddy125/project-management.git"
        GIT_CREDENTIALS_ID    = "terra-github"
        DOCKER_CREDENTIALS_ID = "anand-dockerhub"
        IMAGE_REPO            = "anrs125/reports-tesing"
        DEPLOY_ENV            = "production"
    }

    stages {

        /* ================= VALIDATE TAG ================= */
        stage('Validate Tag') {
            steps {
                script {
                    if (!env.GIT_BRANCH) {
                        error("❌ GIT_BRANCH not set. This job must be triggered by Git")
                    }

                    if (!env.GIT_BRANCH.startsWith("refs/tags/")) {
                        error("❌ This pipeline runs ONLY for git tags")
                    }

                    env.TAG_NAME = env.GIT_BRANCH.replace("refs/tags/", "")

                    if (!env.TAG_NAME.matches(/^v\\d+\\.\\d+\\.\\d+$/)) {
                        error("❌ Invalid tag format: ${env.TAG_NAME}. Expected vX.Y.Z")
                    }

                    echo "✅ Production release detected: ${env.TAG_NAME}"
                }
            }
        }

        /* ================= CHECKOUT TAG ================= */
        stage('Checkout Tag') {
            steps {
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: "refs/tags/${env.TAG_NAME}"]],
                    userRemoteConfigs: [[
                        url: env.GIT_REPO,
                        credentialsId: env.GIT_CREDENTIALS_ID
                    ]]
                ])
            }
        }

        /* ================= BUILD & PUSH ================= */
        stage('Build & Push Docker Image') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: env.DOCKER_CREDENTIALS_ID,
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )
                ]) {
                    sh """
                        echo "\$DOCKER_PASS" | docker login -u "\$DOCKER_USER" --password-stdin
                        docker build -t ${IMAGE_REPO}:${TAG_NAME} .
                        docker push ${IMAGE_REPO}:${TAG_NAME}
                        docker logout
                    """
                }
            }
        }

        /* ================= DEPLOY ================= */
        stage('Deploy to Production') {
            steps {
                echo "🔥 Deploying ${TAG_NAME} to PRODUCTION"
                // Example:
                // helm upgrade reports ./helm --set image.tag=${TAG_NAME}
                // OR
                // argocd app sync reports-prod
            }
        }
    }

    post {
        success {
            echo "✅ PRODUCTION deployment successful for ${TAG_NAME}"
        }
        failure {
            echo "❌ PRODUCTION deployment failed for ${TAG_NAME}"
        }
        always {
            cleanWs()
        }
    }
}
