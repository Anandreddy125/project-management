pipeline {
    agent any

    options {
        disableConcurrentBuilds()
        timestamps()
    }

    environment {
        GIT_REPO           = "https://github.com/Anandreddy125/project-management.git"
        GIT_CREDENTIALS_ID = "terra-github"
    }

    parameters {
        string(
            name: 'RELEASE_TAG',
            defaultValue: 'v1.2.7',
            description: 'Release tag to create (example: v1.2.7)'
        )
    }

    stages {

        stage('Checkout Master') {
            steps {
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: 'master']],
                    userRemoteConfigs: [[
                        url: env.GIT_REPO,
                        credentialsId: env.GIT_CREDENTIALS_ID
                    ]]
                ])
            }
        }

        stage('Merge Staging into Master') {
            steps {
                sh """
                    set -e
                    git config user.name "jenkins"
                    git config user.email "jenkins@ci.local"

                    git switch master
                    git fetch origin
                    git merge origin/staging --no-ff -m "Merge staging into master"
                """
            }
        }

        stage('Create & Push Tag') {
            steps {
                sh """
                    set -e
                    git tag ${params.RELEASE_TAG}
                    git push origin ${params.RELEASE_TAG}
                """
            }
        }
    }

    post {
        success {
            echo "✅ staging merged into master and tag ${params.RELEASE_TAG} pushed"
        }
        failure {
            echo "❌ Merge or tag failed"
        }
    }
}
